{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Music Runtime SBOM Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "source_revision", "model_revision", "runtime_image_ref", "runtime_image_sha256", "sbom_format", "sbom_sha256", "component_count", "unresolved_license_count", "unresolved_license_components", "components", "review_status"],
  "properties": {
    "schema_version": { "const": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "model_revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "runtime_image_ref": { "type": "string", "pattern": "@sha256:[0-9a-fA-F]{64}$" },
    "runtime_image_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sbom_format": { "const": "CycloneDX" },
    "sbom_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "component_count": { "type": "integer", "minimum": 1 },
    "unresolved_license_count": { "type": "integer", "minimum": 0 },
    "unresolved_license_components": { "type": "array" },
    "components": { "type": "array", "minItems": 1 },
    "review_status": { "const": "PENDING_REVIEW" }
  }
}
