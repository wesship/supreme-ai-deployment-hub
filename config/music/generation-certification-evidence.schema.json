{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACE-Step Generation Certification Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "source_revision",
    "model_revision",
    "weights_manifest_sha256",
    "runtime_image_sha256",
    "gpu_model",
    "gpu_driver",
    "cuda_version",
    "torch_version",
    "total_generations",
    "successful_generations",
    "failed_generations",
    "generation_error_rate",
    "p50_generation_seconds",
    "p95_generation_seconds",
    "peak_vram_gb",
    "deterministic_seed_match",
    "audio_qa_passed",
    "audio_qa_report_sha256",
    "provenance_manifest_sha256",
    "review_status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "provider_id": { "const": "ace-step-1.5" },
    "source_revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "model_revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "weights_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runtime_image_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gpu_model": { "type": "string", "minLength": 1 },
    "gpu_driver": { "type": "string", "minLength": 1 },
    "cuda_version": { "type": "string", "minLength": 1 },
    "torch_version": { "type": "string", "minLength": 1 },
    "total_generations": { "type": "integer", "minimum": 25 },
    "successful_generations": { "type": "integer", "minimum": 25 },
    "failed_generations": { "type": "integer", "minimum": 0 },
    "generation_error_rate": { "type": "number", "minimum": 0, "maximum": 0.02 },
    "p50_generation_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "p95_generation_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
    "peak_vram_gb": { "type": "number", "exclusiveMinimum": 0 },
    "deterministic_seed_match": { "const": true },
    "audio_qa_passed": { "const": true },
    "audio_qa_report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provenance_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "review_status": { "const": "PENDING_REVIEW" }
  }
}
