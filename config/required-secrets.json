{
  "version": 3,
  "environments": {
    "production": {
      "github": [
        "OPENAI_API_KEY",
        "SUPABASE_SERVICE_ROLE_KEY"
      ],
      "github_admin_optional": [
        "SUPABASE_ACCESS_TOKEN",
        "SUPABASE_DB_PASSWORD",
        "VERCEL_TOKEN"
      ],
      "github_optional": [
        "SUPABASE_URL",
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_PUBLISHABLE_KEY",
        "VITE_SUPABASE_ANON_KEY",
        "RAILWAY_TOKEN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_DSN",
        "VITE_SENTRY_DSN",
        "CODECOV_TOKEN",
        "SNYK_TOKEN",
        "GH_TOKEN_WRITE",
        "GH_PAT",
        "GITHUB_PAT",
        "E2E_TEST_EMAIL",
        "E2E_TEST_PASSWORD"
      ],
      "frontend": [
        "VITE_API_URL",
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_PUBLISHABLE_KEY"
      ],
      "backend": [
        "OPENAI_API_KEY",
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "ENCRYPTION_KEY"
      ],
      "optional": [
        "SENTRY_DSN",
        "CODECOV_TOKEN",
        "SNYK_TOKEN",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET"
      ],
      "deployment_controls": [
        "HOSTINGER_SELF_HOSTED_RUNNER",
        "D3VONN_RESTRICTED_DEPLOY_WRAPPER",
        "VERCEL_GIT_INTEGRATION"
      ]
    }
  },
  "aliases": [
    {
      "id": "supabase-project-identifier",
      "names": ["SUPABASE_PROJECT_ID", "SUPABASE_PROJECT_REF", "PROJECT_ID"],
      "action": "configuration-not-secret"
    },
    {
      "id": "github-release-token",
      "names": ["GH_TOKEN_WRITE", "GH_PAT", "GITHUB_PAT"],
      "preferred": "GITHUB_TOKEN",
      "action": "prefer-built-in-token-or-oidc"
    },
    {
      "id": "supabase-browser-key",
      "names": ["VITE_SUPABASE_PUBLISHABLE_KEY", "VITE_SUPABASE_ANON_KEY"],
      "preferred": "VITE_SUPABASE_PUBLISHABLE_KEY",
      "action": "canary-before-retirement"
    }
  ],
  "policy": {
    "storeValuesInRepository": false,
    "presenceReportsContainValues": false,
    "productionRequiresApproval": true,
    "hostingerUsesHostedRunnerSsh": false,
    "hostingerRunnerMustNotUseDockerGroup": true,
    "preferredProvider": "infisical",
    "preferredAuthentication": "oidc-or-short-lived-machine-identity"
  }
}
