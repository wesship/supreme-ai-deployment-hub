  "deployment_readiness": {
    "requires_staging_validation": true,
    "requires_migration_dry_run": true,
    "requires_compliance_signoff": true,
    "requires_workspace_admin_signoff": true,
    "requires_rollback_plan": true,
    "requires_incident_owner": true
  }
