{
  "service": "hermes",
  "environment": "production",
  "deploy_target": "vps",
  "deployment_id": "replace-with-deployment-id",
  "git_sha": "replace-with-current-main-sha",
  "config_version": "1",
  "db_migration_version": "replace-with-latest-applied-migration",
  "kg_schema_version": "1",
  "agent_manifest_version": "1",
  "recency_sync_required": true,
  "startup_required_checks": [
    "backend_health_http_200",
    "jwt_secret_present",
    "encryption_key_present",
    "secret_manager_initialized",
    "database_connection_ready",
    "redis_connection_ready",
    "hermes_job_intake_ready",
    "hermes_worker_registration_ready",
    "hermes_callback_ready",
    "memory_writeback_ready",
    "knowledge_graph_writeback_ready"
  ],
  "blocked_integrations_until_ready": [
    "vapi",
    "voice_services",
    "production_agent_traffic",
    "public_dashboards"
  ]
}
