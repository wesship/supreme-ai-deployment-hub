{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d3vonn.io/schemas/marketplace-agent-manifest-1.0.json",
  "title": "D3VONN.IO Marketplace Agent Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publisher", "capabilities", "permissions", "dependencies", "integrations", "dataRequirements", "updatePolicy", "rollbackSupported"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "publisher": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "items": { "enum": ["monitoring", "alerting", "remediation", "reporting", "integration", "scheduling", "ml-powered"] }, "uniqueItems": true },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "description", "risk", "required"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "risk": { "enum": ["low", "medium", "high", "critical"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string" },
          "required": { "type": "boolean" },
          "healthy": { "type": "boolean" }
        }
      }
    },
    "integrations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "dataRequirements": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "updatePolicy": { "enum": ["automatic", "approval-required", "manual"] },
    "rollbackSupported": { "type": "boolean" }
  }
}
