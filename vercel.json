{
  "buildCommand": "pnpm run vercel-build",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "installCommand": "corepack enable && corepack prepare pnpm@9.15.9 --activate && pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/health", "destination": "/health.json" },
    { "source": "/d3vonn-logo.webp", "destination": "/d3vonn-main-logo.svg" },
    { "source": "/solutions", "destination": "/solutions.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/security", "destination": "/security.html" },
    { "source": "/security/disclosure", "destination": "/security/disclosure.html" },
    { "source": "/resources", "destination": "/resources.html" },
    { "source": "/ai-agents", "destination": "/ai-agents.html" },
    { "source": "/business-automation", "destination": "/business-automation.html" },
    { "source": "/marketplace", "destination": "/marketplace.html" },
    { "source": "/film", "destination": "/film.html" },
    { "source": "/documentation", "destination": "/documentation.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/enterprise-readiness", "destination": "/enterprise-readiness.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy-policy", "destination": "/privacy.html" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=0, must-revalidate" }
      ]
    },
    {
      "source": "/health",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/(app|admin|occ|dashboard|login|signin|signup|unauthorized|github-diagnostic|command-center|agents|workflows|deployment|api|flow|status|manifest|chat|voice-studio|research-os|dkos-ingestion|knowledge-ingestion|jetson|jetson-control|backtesting)(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/security/(ops|dashboard|command-center)(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" }
      ]
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/film%60", "destination": "/film", "permanent": false },
    { "source": "/film`", "destination": "/film", "permanent": false },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "d3vonn.io" }
      ],
      "destination": "https://www.d3vonn.io/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "app.d3vonn.io" }
      ],
      "destination": "https://www.d3vonn.io/app",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "app.d3vonn.io" }
      ],
      "destination": "https://www.d3vonn.io/:path*",
      "permanent": true
    },
    { "source": "/analytics", "destination": "/app", "permanent": false },
    { "source": "/rag", "destination": "/dkos-ingestion", "permanent": true }
  ]
}
