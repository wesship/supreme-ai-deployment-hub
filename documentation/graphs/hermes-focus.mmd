    classDef integration fill:#D97706,stroke:#78350F,color:#fff
    classDef security fill:#DC2626,stroke:#7F1D1D,color:#fff
    classDef knowledge fill:#7C3AED,stroke:#4C1D95,color:#fff
    classDef event fill:#EC4899,stroke:#831843,color:#fff