# D3VONN.IO Hostinger VPS Environment Template
# Copy this file to deploy/vps/.env on the server.
# Never commit deploy/vps/.env with real values.

ENVIRONMENT=production
DOMAIN=d3vonn.io
PUBLIC_BASE_URL=https://d3vonn.io
API_BASE_URL=https://api.d3vonn.io
CORS_ORIGINS=https://d3vonn.io,https://www.d3vonn.io,https://app.d3vonn.io

# Frontend public build values
VITE_API_URL=https://api.d3vonn.io
VITE_ENVIRONMENT=production
VITE_SUPABASE_URL=replace_me
VITE_SUPABASE_PUBLISHABLE_KEY=replace_me

# Backend required values
SUPABASE_URL=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
JWT_SECRET=replace_me
ENCRYPTION_KEY=replace_me

# Runtime settings
REDIS_PASSWORD=replace_me
HERMES_MODE=orchestrator
HERMES_MAX_CONCURRENT_TASKS=5
HERMES_AGENT_ID=d3vonn-hermes
PINECONE_ENVIRONMENT=replace_me
PINECONE_INDEX=devonn-rag

# External provider credentials
# Fill these only on the VPS. Keep replace_me in git.
OPENAI_API_KEY=replace_me
ANTHROPIC_API_KEY=replace_me
OPENROUTER_API_KEY=replace_me
PINECONE_API_KEY=replace_me
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_PHONE_NUMBER=replace_me
TELEGRAM_BOT_TOKEN=replace_me
VAPI_API_KEY=replace_me
GITHUB_TOKEN=replace_me

# Vault/proxy mode placeholders
AGENT_VAULT_BASE_URL=https://vault.d3vonn.io
AGENT_VAULT_MASTER_KEY=replace_me
AGENT_VAULT_ADMIN_TOKEN=replace_me
AGENT_VAULT_AGENT_TOKEN=replace_me

# Monitoring
SENTRY_DSN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_me

# Backups
BACKUP_DIR=/opt/d3vonn/backups
BACKUP_RETENTION_DAYS=14
