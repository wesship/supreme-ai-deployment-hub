# Trusted Nous Research release identity. The updater rejects repository overrides.
HERMES_UPSTREAM_REPO=https://github.com/NousResearch/hermes-agent.git
HERMES_UPSTREAM_TAG=v2026.8.27
HERMES_UPSTREAM_COMMIT=5fc308a70719a83cccdbba4c0e39c23f5a8239d5
HERMES_UPSTREAM_VERSION=0.20.6

# Releases are built beneath this root. The updater only advances the `staged`
# symlink; it never changes a production `current` symlink or restarts services.
HERMES_UPSTREAM_ROOT=/opt/d3vonn/hermes-upstream
