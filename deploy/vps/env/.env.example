# =============================================================================
# D3VONN.IO — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values before deployment.
# NEVER commit the .env file to version control.
# =============================================================================

# ── Domain Configuration ─────────────────────────────────────────────────────
DOMAIN=d3vonn.io
API_DOMAIN=api.d3vonn.io
VITE_API_URL=https://api.d3vonn.io

# ── Supabase (Managed Database & Auth) ───────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ── AI Provider Keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=...

# ── Pinecone (Vector Database) ───────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=generate-a-strong-random-secret-here

# ── Twilio (Communications) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# ── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-strong-password

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=generate-a-strong-redis-password

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://d3vonn.io,https://www.d3vonn.io

# ── Hermes Configuration ─────────────────────────────────────────────────────
HERMES_MAX_CONCURRENT_TASKS=10
HERMES_MODE=orchestrator

# ── Security Agent ───────────────────────────────────────────────────────────
SECURITY_SCAN_INTERVAL=300

# ── SSL (Let's Encrypt) ─────────────────────────────────────────────────────
CERTBOT_EMAIL=admin@d3vonn.io

# ── Backup Configuration ────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=d3vonn-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
