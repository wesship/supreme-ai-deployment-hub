# =============================================================================
# D3VONN.IO — Environment Variables Template
# =============================================================================
# Copy this file to .env.production or .env and fill in the values before deployment.
# NEVER commit real .env files or production secret values to version control.
# =============================================================================

# ── Domain Configuration ─────────────────────────────────────────────────────
DOMAIN=d3vonn.io
API_DOMAIN=api.d3vonn.io
VITE_API_URL=https://api.d3vonn.io

# ── Supabase (Managed Database & Auth) ───────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional only if an Edge Function performs manual JWT verification.
# Prefer Supabase platform JWT verification when possible.
# If used by code, this must be raw JWKS JSON, not a URL.
SUPABASE_JWKS={"keys":[]}

# ── AI Provider Keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=...

# ── Pinecone / RAG (Backend Only) ────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_HOST=https://your-index-host.svc.your-region.pinecone.io
PINECONE_INDEX=devonn-rag
EMBEDDING_MODEL=text-embedding-3-small

# ── Authentication / Encryption ──────────────────────────────────────────────
JWT_SECRET=generate-a-strong-random-secret-here
ENCRYPTION_KEY=generate-a-strong-32-byte-encryption-secret-here
API_KEY_VAULT_SECRET=generate-a-strong-vault-secret-here

# ── Twilio (Communications) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15555550123

# ── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-strong-password

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=generate-a-strong-redis-password

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://d3vonn.io,https://www.d3vonn.io,https://app.d3vonn.io
ALLOWED_ORIGINS=https://d3vonn.io,https://www.d3vonn.io,https://app.d3vonn.io

# ── Hermes Configuration ─────────────────────────────────────────────────────
HERMES_MAX_CONCURRENT_TASKS=10
HERMES_MODE=orchestrator

# ── Security Agent ───────────────────────────────────────────────────────────
SECURITY_SCAN_INTERVAL=300

# ── SSL (Let's Encrypt) ─────────────────────────────────────────────────────
CERTBOT_EMAIL=admin@d3vonn.io

# ── Backup Configuration ────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=d3vonn-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
