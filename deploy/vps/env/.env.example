# =============================================================================
# D3VONN.IO — Environment Variables Template
# =============================================================================
# Copy this file to .env.production or .env and fill in the values before deployment.
# NEVER commit real .env files or production secret values to version control.
# =============================================================================

# ── Domain Configuration ─────────────────────────────────────────────────────
DOMAIN=d3vonn.io
API_DOMAIN=api.d3vonn.io
VITE_API_URL=https://api.d3vonn.io
BACKEND_PORT=8000
APP_ENV=production
ENVIRONMENT=production
DEBUG=false

# ── Supabase (Managed Database & Auth) ───────────────────────────────────────
SUPABASE_URL=https://tjygexesognbkwualywq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
VITE_SUPABASE_URL=https://tjygexesognbkwualywq.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Optional only if an Edge Function performs manual JWT verification.
# Prefer Supabase platform JWT verification when possible.
SUPABASE_JWKS={"keys":[]}

# ── AI Provider Keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY=replace-with-openai-key
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7
ANTHROPIC_API_KEY=replace-with-anthropic-key
GOOGLE_AI_API_KEY=replace-with-google-ai-key
HF_API_TOKEN=

# ── Voice / Speech ───────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_DEFAULT_MODEL=eleven_turbo_v2_5
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# ── Pinecone / RAG (Backend Only) ────────────────────────────────────────────
PINECONE_API_KEY=replace-with-pinecone-key
PINECONE_HOST=your-index-host.svc.your-region.pinecone.io
PINECONE_INDEX_NAME=devonn-rag
PINECONE_DIMENSION=1536
PINECONE_NAMESPACE=documents
RAG_TOP_K=5
RAG_MIN_SCORE=0.70
EMBEDDING_MODEL=text-embedding-3-small
EMBED_BATCH_SIZE=20

# ── Database / Redis ─────────────────────────────────────────────────────────
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=generate-a-strong-redis-password

# ── Authentication / Encryption ──────────────────────────────────────────────
JWT_SECRET=generate-a-strong-random-secret-here
JWT_ALGORITHM=HS256
REQUIRE_AUTH=true
ENCRYPTION_KEY=generate-a-strong-32-byte-encryption-secret-here
API_KEY_VAULT_SECRET=generate-a-strong-vault-secret-here
WS_AUTH_TOKEN=generate-a-strong-websocket-token-here

# ── GitHub / CI-CD ───────────────────────────────────────────────────────────
# Fine-grained token only; never expose this to the frontend.
GITHUB_TOKEN=
GITHUB_REPO=wesship/supreme-ai-deployment-hub

# ── Automation ───────────────────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.d3vonn.io
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# ── Twilio (Communications) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Monitoring ───────────────────────────────────────────────────────────────
# Leave SENTRY_DSN blank unless you have a real DSN.
SENTRY_DSN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-strong-password

# ── CORS ─────────────────────────────────────────────────────────────────────
# backend/app/config.py reads ALLOWED_ORIGINS_RAW.
ALLOWED_ORIGINS_RAW=https://d3vonn.io,https://www.d3vonn.io,https://app.d3vonn.io,https://supreme-ai-deployment-hub.vercel.app
ALLOWED_ORIGIN_REGEX=https://([a-z0-9-]+\.)*(lovable\.app|lovableproject\.com|vercel\.app)

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20

# ── Hermes Configuration ─────────────────────────────────────────────────────
HERMES_MAX_CONCURRENT_TASKS=10
HERMES_MODE=orchestrator

# ── Security Agent ───────────────────────────────────────────────────────────
SECURITY_SCAN_INTERVAL=300

# ── SSL (Let's Encrypt) ─────────────────────────────────────────────────────
CERTBOT_EMAIL=admin@d3vonn.io

# ── Backup Configuration ─────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=d3vonn-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
