# Hermes Model Council is opt-in until rollout gates pass.
HERMES_MODEL_COUNCIL_ENABLED=false
# Shadow mode may only be enabled together with the feature flag. In shadow mode,
# the council evaluates candidates but never returns an authoritative winner.
HERMES_MODEL_COUNCIL_SHADOW_MODE=false
# Explicit provider:model pairs used by staging shadow evaluation. No model is
# guessed when this value is empty; the runtime emits model_council.shadow.skipped.
HERMES_MODEL_COUNCIL_CANDIDATES=
