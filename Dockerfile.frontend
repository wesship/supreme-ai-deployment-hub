# ── Frontend Dockerfile (Devonn.AI Vite/React) ───────────────────────────────
# HARDENING vs original:
#   1. node:20-alpine → node:22-alpine (matches CI Node version)
#   2. Removed `bun.lockb*` from COPY (bun lock files removed from repo)
#   3. Uses pnpm monorepo install for VPS builds
#   4. Added typecheck step before build to catch TS errors in Docker builds
#   5. Added non-root user in nginx stage for security
#   6. Added nginx security headers config

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

ARG VITE_API_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_ENVIRONMENT=production
ARG VITE_SENTRY_DSN
ARG VITE_N8N_BASE_URL

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_ENVIRONMENT=$VITE_ENVIRONMENT
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_N8N_BASE_URL=$VITE_N8N_BASE_URL

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy lock file and manifest first for layer caching
COPY package.json pnpm-lock.yaml ./

# Use no-frozen-lockfile on VPS so deployment is not blocked by lock drift.
# Long-term CI should keep pnpm-lock.yaml committed and return this to --frozen-lockfile.
RUN pnpm install --no-frozen-lockfile

# Copy source code
COPY . .

# Typecheck before building — fail fast on TypeScript errors
RUN pnpm run typecheck

# Build production bundle
RUN pnpm run build

# ── Stage 2: Serve with Nginx ─────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Create non-root user for nginx worker processes
RUN adduser -D -H -u 1001 -s /sbin/nologin nginxuser

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy hardened nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Nginx needs to write to these paths — adjust ownership
RUN chown -R nginxuser:nginxuser /var/cache/nginx /var/log/nginx /etc/nginx/conf.d \
    && touch /var/run/nginx.pid \
    && chown nginxuser:nginxuser /var/run/nginx.pid

USER nginxuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
