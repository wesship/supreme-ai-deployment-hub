{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devonn.ai/schemas/concept.schema.json",
  "title": "PRIMETIME Concept",
  "type": "object",
  "required": ["conceptId", "workspaceId", "name", "type", "status", "confidence", "sources", "version"],
  "properties": {
    "conceptId": {"type": "string", "minLength": 8},
    "workspaceId": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 300},
    "canonicalName": {"type": "string", "maxLength": 300},
    "type": {"type": "string", "enum": ["concept", "entity", "claim", "question", "risk", "policy", "workflow", "agent", "decision", "evidence", "artifact", "requirement"]},
    "description": {"type": "string", "maxLength": 5000},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"type": "string", "enum": ["DISCOVERED", "EXTRACTED", "NORMALIZED", "DUPLICATE_REVIEW", "VALIDATION_REQUIRED", "VALIDATED", "APPROVED", "CANONICAL", "REJECTED", "SUPERSEDED", "ARCHIVED"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceReference"}},
    "jurisdiction": {"type": "string"},
    "createdBy": {"type": "string"},
    "approvedBy": {"type": ["string", "null"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "sourceReference": {
      "type": "object",
      "required": ["sourceId", "sourceType", "locator", "retrievedAt"],
      "properties": {
        "sourceId": {"type": "string"},
        "sourceType": {"type": "string", "enum": ["pdf", "docx", "pptx", "web", "video", "audio", "crm", "email", "github", "workflow", "note", "database"]},
        "locator": {"type": "string"},
        "excerpt": {"type": "string", "maxLength": 10000},
        "contentHash": {"type": "string"},
        "retrievedAt": {"type": "string", "format": "date-time"},
        "extractor": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
