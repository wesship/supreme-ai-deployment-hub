{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.godot-worker"
  },
  "deploy": {
    "preDeployCommand": [
      "/usr/local/bin/godot --headless --path /workspace/smoke --quit-after 2"
    ],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
