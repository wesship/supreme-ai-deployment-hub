# ─────────────────────────────────────────────────────────────────────────────
# Devonn.ai Backend Proxy — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# ── Voice ─────────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=el-...
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_DEFAULT_MODEL=eleven_turbo_v2_5
ASSEMBLYAI_API_KEY=...

# ── CI/CD ─────────────────────────────────────────────────────────────────────
# Use a fine-grained PAT with minimal permissions:
#   - Repository: wesship/supreme-ai-deployment-hub
#   - Permissions: Actions (read/write), Contents (read)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=wesship/supreme-ai-deployment-hub

# ── Automation ────────────────────────────────────────────────────────────────
N8N_API_KEY=...
N8N_BASE_URL=https://n8n.devonn.ai

# ── Vector DB ─────────────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_HOST=<your-index-host>.svc.pinecone.io
PINECONE_INDEX_NAME=document-store
PINECONE_DIMENSION=768
PINECONE_NAMESPACE=documents

# ── Auth (Supabase) ───────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key — never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...
JWT_SECRET=<your-jwt-secret>
REQUIRE_AUTH=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://devonn.ai,https://www.devonn.ai,https://app.devonn.ai,https://supreme-ai-deployment-hub.vercel.app

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
ENVIRONMENT=production

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
