# D3VONN Pocket Node local configuration
POCKET_MODE=AIRGAP
POCKET_BIND_HOST=127.0.0.1
POCKET_PORT=11435
POCKET_MODEL=models/general/model.gguf
POCKET_CONTEXT_SIZE=8192
POCKET_THREADS=0
POCKET_GPU_LAYERS=0
POCKET_TELEMETRY=off
POCKET_ALLOW_PROCESS_TOOLS=false

# BRIDGE mode only. Keep actual credentials outside version control.
D3VONN_BRIDGE_ENDPOINT=
D3VONN_BRIDGE_TOKEN=
