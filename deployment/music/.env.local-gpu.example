# Copy to .env.local-gpu. This file contains no secrets; never commit its copy.

# Absolute path to an official ACE-Step 1.5 source checkout.
ACESTEP_SOURCE_DIR=/srv/ACE-Step-1.5
ACESTEP_IMAGE_TAG=local
ACESTEP_CUDA_VERSION=12.8.1

# Generate a high-entropy API key and place the same value in the private
# connector and the ACESTEP_API_KEY function secret. Do not expose port 8001.
ACESTEP_API_KEY=replace-with-a-long-random-secret

# The local service is intentionally loopback-only. A private connector must
# forward this address to the D3VONN service plane with TLS and authentication.
ACESTEP_API_PORT=8001
ACESTEP_CHECKPOINTS_DIR=/srv/d3vonn-music/checkpoints
ACESTEP_OUTPUT_DIR=/srv/d3vonn-music/output

# Conservative defaults for 6–8 GB VRAM. Choose a higher tier only after a
# health probe confirms available VRAM and a successful smoke generation.
ACESTEP_INIT_SERVICE=true
ACESTEP_CONFIG_PATH=acestep-v15-turbo
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-0.6B
ACESTEP_LLM_BACKEND=pt
ACESTEP_OFFLOAD_TO_CPU=false
ACESTEP_QUEUE_MAXSIZE=20
ACESTEP_QUEUE_WORKERS=1
