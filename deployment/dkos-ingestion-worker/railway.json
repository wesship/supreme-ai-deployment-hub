{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deployment/dkos-ingestion-worker/Dockerfile",
    "watchPatterns": [
      "deployment/dkos-ingestion-worker/**",
      "deployment/dkos-ingestion-requirements.txt"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
