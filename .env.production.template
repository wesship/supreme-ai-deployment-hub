# =============================================================================
# Devonn.ai / Supreme AI Deployment Hub — Production Environment Variables
# =============================================================================
#
# SECURITY RULE:
#   VITE_ prefix = bundled into browser JavaScript = visible to all users.
#   Only non-sensitive, public values may use the VITE_ prefix.
#   All API keys and secrets must be server-side only (no VITE_ prefix).
#
# =============================================================================

# ── FRONTEND (Vercel — VITE_ prefix, safe to expose) ─────────────────────────

# Backend proxy URL (all LLM/tool/voice calls go through here)
VITE_API_URL=https://api.d3vonn.io

# Application metadata
VITE_APP_NAME="Supreme AI Deployment Hub"
VITE_APP_VERSION="1.0.0"

# Supabase (anon key is public by design — safe in browser)
VITE_SUPABASE_URL=https://tjygexesognbkwualywq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-anon-key>

# Pinecone index metadata (not secrets — API key is server-side)
VITE_PINECONE_HOST=<pinecone-index-host>
VITE_PINECONE_INDEX_NAME=document-store
VITE_PINECONE_DIMENSION=768

# n8n public webhook base URL (no auth in URL)
VITE_N8N_BASE_URL=https://n8n.d3vonn.io

# Monitoring (auto-generated by Vercel, not a secret)
VITE_VERCEL_ANALYTICS_ID=<auto-generated-by-vercel>

# =============================================================================
# ── BACKEND (api.d3vonn.io — server-side only, NEVER use VITE_ prefix) ───────
# =============================================================================

# Authentication
JWT_SECRET=<generate-256-bit-key>
ENCRYPTION_KEY=<generate-256-bit-key>

# LLM providers (proxied via /api/chat)
OPENAI_API_KEY=<openai-api-key>
HUGGINGFACE_API_KEY=<huggingface-api-key>

# Voice services (proxied via /api/tools/voice/*)
ELEVENLABS_API_KEY=<elevenlabs-api-key>
ASSEMBLYAI_API_KEY=<assemblyai-api-key>

# CI/CD and automation (proxied via /api/tools/github/* and /api/tools/n8n/*)
# Use a fine-grained PAT scoped to wesship/supreme-ai-deployment-hub only
GITHUB_TOKEN=<github-fine-grained-pat>
N8N_API_KEY=<n8n-api-key>

# Vector database (server-side RAG pipeline)
PINECONE_API_KEY=<pinecone-api-key>

# Supabase service role (server-side DB operations only)
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# AWS
AWS_ACCESS_KEY_ID=<aws-access-key>
AWS_SECRET_ACCESS_KEY=<aws-secret-key>
AWS_REGION=us-east-1

# Observability
SENTRY_DSN=<sentry-dsn>

NODE_ENV=production
