# .env.example — Copy to .env and fill in your values before running locally.
# Never commit a .env file with real secrets.

# ─── Required ────────────────────────────────────────────────────────────────
GH_TOKEN=
OPENAI_API_KEY=
VERCEL_TOKEN=
# Note: GitHub Actions workflows use GITHUB_TOKEN (built-in) or GH_TOKEN_WRITE
# (repo secret). The canonical local variable is GH_TOKEN above.

# ─── Devonn Ecosystem ─────────────────────────────────────────────────────────
ORGANIZATION=wesship
WORKSPACE_DIR=~/DevonnAI_AutoHealer
CLONE_PROTOCOL=https                  # https or ssh

# ─── Service URLs (defaults work for Render deployments) ─────────────────────
ORCHESTRATOR_URL=https://central-orchestrator.onrender.com
GATEWAY_URL=https://openclaw-gateway-2t9e.onrender.com

# ─── Hermes Orchestrator ─────────────────────────────────────────────────────
POLL_INTERVAL=30                      # seconds between queue polls

# ─── MCP API (supreme-ai-deployment-hub) ─────────────────────────────────────
JWT_SECRET=
ENCRYPTION_KEY=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=devonn

# ─── Supabase (set via platform env vars in production) ──────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ─── Cloud Providers (optional) ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ROLE_ARN=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
GCP_CREDENTIALS_JSON=

# ─── CI / Security tokens (optional, set in GitHub Actions secrets) ──────────
CODECOV_TOKEN=
SNYK_TOKEN=

# ─── Notifications (optional) ────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
NOTIFICATION_EMAIL=
