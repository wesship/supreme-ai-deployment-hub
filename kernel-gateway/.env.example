# Generate with: openssl rand -base64 48
KERNEL_GATEWAY_API_TOKEN=replace-with-a-long-random-secret

# Use a pinned n8n tag or, preferably, an immutable image digest.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:replace-with-pinned-version

KERNEL_MAX_SESSIONS=8
KERNEL_SESSION_TTL_SECONDS=1800
KERNEL_EXECUTION_TIMEOUT_SECONDS=15
KERNEL_MAX_CODE_BYTES=65536
KERNEL_MAX_OUTPUT_BYTES=1048576
