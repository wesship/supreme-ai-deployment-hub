FROM node:22-slim

WORKDIR /app
ENV NODE_ENV=production

COPY scripts/run-ai-therapy-shadow-provider.mjs ./scripts/run-ai-therapy-shadow-provider.mjs
COPY scripts/validate-ai-therapy-shadow-adapter-results.mjs ./scripts/validate-ai-therapy-shadow-adapter-results.mjs
COPY scripts/build-ai-therapy-shadow-evidence.mjs ./scripts/build-ai-therapy-shadow-evidence.mjs
COPY scripts/ai-therapy/providers/openai-shadow-evaluator.mjs ./scripts/ai-therapy/providers/openai-shadow-evaluator.mjs
COPY docs/ai-therapy/behavioral-shadow-fixtures.json ./docs/ai-therapy/behavioral-shadow-fixtures.json

RUN useradd --uid 10001 --create-home shadow && chown -R shadow:shadow /app
USER shadow

CMD ["sh", "-lc", "set +e; node scripts/run-ai-therapy-shadow-provider.mjs; p=$?; node scripts/validate-ai-therapy-shadow-adapter-results.mjs; v=$?; node scripts/build-ai-therapy-shadow-evidence.mjs; b=$?; echo SHADOW_EVIDENCE_BEGIN; cat ${AI_THERAPY_SHADOW_ARTIFACT:-.ai-therapy-evidence/live-shadow.json} 2>/dev/null || true; echo SHADOW_EVIDENCE_END; test $p -eq 0 -a $v -eq 0 -a $b -eq 0"]
