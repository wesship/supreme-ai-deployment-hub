# Railway-optimized backend Dockerfile
# Backend-only image, uses $PORT from Railway
FROM python:3.12-slim

WORKDIR /app

# Keep system executables discoverable for API and Hermes worker processes even when
# the hosting platform injects a restricted PATH.
ENV PATH="/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"

# Install system dependencies required by the API and AI FILMS mastering worker.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl ffmpeg \
    && command -v ffmpeg \
    && command -v ffprobe \
    && ffmpeg -version >/dev/null \
    && ffprobe -version >/dev/null \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first for better Docker layer caching
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy only runtime backend source; keep frontend/docs/dev tooling out of Railway image
COPY backend/ ./backend/
COPY MASTER_CONTEXT.md ./MASTER_CONTEXT.md

# Set Python path
ENV PYTHONPATH=/app:/app/backend

# Create a non-root user for security hardening
# Railway runs as root by default — this enforces least-privilege execution
RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid appgroup --shell /bin/bash --create-home appuser && \
    chown -R appuser:appgroup /app

USER appuser

# Re-assert the runtime dependency after dropping privileges. This makes an image
# unusable at build time instead of discovering a missing FFmpeg binary in production.
RUN command -v ffmpeg && command -v ffprobe

# Health check using curl
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Expose port (Railway uses $PORT)
EXPOSE 8000

# Start command — Railway injects $PORT
CMD ["sh", "-c", "uvicorn backend.railway_app:app --host 0.0.0.0 --port ${PORT:-8000}"]
