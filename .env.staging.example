# Devonn.ai staging environment example
# Safe placeholders only. Do not commit real secrets.

# Frontend
VITE_ENVIRONMENT=staging
VITE_API_URL=https://staging-api.d3vonn.io
VITE_APP_VERSION=staging-local
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-staging-anon-key

# Runtime / API
NODE_ENV=staging
DEPLOYMENT_VERSION=staging-local
DATABASE_URL=postgresql://user:password@host:5432/devonn_staging
REDIS_URL=rediss://default:password@host:6379
JWT_SECRET=replace-with-staging-jwt-secret
ENCRYPTION_KEY=replace-with-staging-encryption-key
OPENAI_API_KEY=replace-with-staging-openai-key

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com
PROMETHEUS_METRICS_PATH=/metrics

# Deployment automation
VERCEL_TOKEN=replace-with-vercel-token
VERCEL_ORG_ID=replace-with-vercel-org-id
VERCEL_PROJECT_ID=replace-with-vercel-project-id
SLACK_WEBHOOK_DEPLOYS=https://hooks.slack.com/services/placeholder
