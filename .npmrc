# Enforce deterministic installs — do NOT use --legacy-peer-deps in CI
# If peer dep errors appear, fix them in package.json instead of suppressing them here.

# Use the public npm registry (normalize away any private registry confusion)
registry=https://registry.npmjs.org/

# Ensure lockfile is always written/respected
package-lock=true

# Fail on missing peer dependencies instead of silently skipping
# (uncomment once peer deps are resolved)
# strict-peer-deps=true

# Engine strict mode — fail if Node version doesn't match engines field
engine-strict=false
