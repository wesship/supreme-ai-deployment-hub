    "http://localhost:4173/marketplace",
    "http://localhost:4173/film",
    "http://localhost:4173/documentation",
    "http://localhost:4173/about",
    "http://localhost:4173/contact",
    "http://localhost:4173/terms",
    "http://localhost:4173/privacy"
  ],
